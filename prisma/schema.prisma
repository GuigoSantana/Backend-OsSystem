// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

enum StatusOrdem {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt      // Importante para auditoria

  id       String   @id @default(uuid())
  nome     String
  cpf      String   @unique
  email    String   @unique
  senha    String
  telefone String

  clientes Cliente[]
  produtos Produto[]
  servicos Servico[]
  ordens   Ordem[]
  entradas Entrada[]
  saidas   Saida[]
}

model Cliente {
  id       String   @id @default(uuid())
  createdAt DateTime @default(now())

  nome     String
  cpf      String   @unique
  email    String   @unique
  telefone String
  endereco String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ordens Ordem[]
}

model Produto {
  id         String  @id @default(uuid())
  nome       String
  descricao  String?

  precoVenda Float  
  precoCusto Float
  estoque    Int

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ordens OrdemProduto[]
}

model Servico {
  id        String @id @default(uuid())
  nome      String
  descricao String
  preco     Float

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ordens OrdemServico[]
}

model Ordem {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  descricao String?
  status    StatusOrdem @default(PENDENTE)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  produtos OrdemProduto[]
  servicos OrdemServico[]
}


model OrdemProduto {
  ordemId   String
  produtoId String

  quantidade Int
  precoUnitario Float

  ordem   Ordem   @relation(fields: [ordemId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([ordemId, produtoId])
}



model OrdemServico {
  ordemId   String
  servicoId String

  quantidade Int @default(1)
  precoUnitario Float

  ordem   Ordem   @relation(fields: [ordemId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])

  @@id([ordemId, servicoId])
}

model Saida {
  id        String @id @default(uuid())
  createdAt DateTime @default(now())
  nome      String
  preco     Float

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Entrada {
  id        String @id @default(uuid())
  createdAt DateTime @default(now())
  nome      String
  preco     Float

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}
